# API origin with no trailing slash. Leave empty to block login (Phase 2).
# Same meaning as EXPO_PUBLIC_API_URL. There is no Android emulator host rewrite.
VITE_API_URL=http://localhost:3000

# Path prefix joined onto the origin for v1 routes. GET /time stays on the origin.
VITE_API_PREFIX=/api/v1

# Show "Discard duplicate / cancel" on Failed sales (unsynced local uploads only).
# Off by default. Set to true / 1 / yes to enable; rebuild required (Vite bake-time).
# VITE_ALLOW_DISCARD_FAILED_SALES=false
